---
import Layout from '../layouts/Layout.astro';
import PanelEngine from '../components/PanelEngine.tsx';
import '@/styles/globals.css';
import { parse } from 'cookie';
import jwt from 'jsonwebtoken';
import { UserRepository } from '../lib/auth/user-repository';
import { connectDB } from '../lib/mongodb';

// Conectar a la base de datos
await connectDB();

const userRepository = new UserRepository();

// Obtener las cookies de la solicitud
const cookies = parse(Astro.request.headers.get('cookie') || '');
const token = cookies.token;

let isAuthenticated = false;

if (token) {
  try {
    // Verificar el token JWT
    const decoded = jwt.verify(token, import.meta.env.SECRET_JWT_KEY);
    if (typeof decoded === 'object' && decoded.userId) {
      // Verificar si el usuario existe en la base de datos
      const user = await userRepository.findById(decoded.userId);
      if (user) {
        isAuthenticated = true;
      }
    }
  } catch (error) {
    console.error('Token inválido:', error);
  }
}

if (!isAuthenticated) {
  return Astro.redirect('/login');
}
---

<Layout title="Panel de administrador">
    <div style="height: 60px;"/>
    <PanelEngine client:load />
    <div style="height: 60px;"/>
</Layout>