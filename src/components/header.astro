---

<style>
  .cursor-active::after {
    content: "|";
    animation: blink 0.7s infinite;
    display: inline-block;
    vertical-align: top;
    line-height: 1.1;
    margin-left: 2px;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  .changing-title {
    font-size: clamp(1.2rem, 4vw, 3.5rem);
    line-height: 1.2;
    font-family: "Playfair Display", serif;
    letter-spacing: -0.02em;
    word-break: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
    max-width: 100%;
    text-align: center;
  }

  @media (max-width: 768px) {
    .changing-title {
      font-size: clamp(1rem, 5vw, 2rem);
    }
  }

  .scroll-indicator {
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(-10px);
    }
    60% {
      transform: translateX(-50%) translateY(-5px);
    }
  }
</style>

<section
  class="hero-gradient flex flex-col items-center justify-center px-3 sm:px-4 theme-transition relative"
  style="height: calc(100vh - 4rem); min-height: 400px;"
>
  <div
    class="text-center max-w-4xl mx-auto w-full flex flex-col items-center justify-center flex-1"
  >
    <!-- Typewriter Title -->
    <h1
      id="changing-title"
      class="changing-title text-gray-200 font-back text-center drop-shadow-lg px-2"
      data-i18n="Title-1"
    >
      DATATRACKER
    </h1>

    <!-- Accent Bar -->
    <div class="flex justify-center">
      <div class="accent-bar w-40 sm:w-56 md:w-72"></div>
    </div>

    <!-- Phrase -->
    <p
      class="mt-4 sm:mt-6 text-gray-200 text-sm sm:text-base md:text-lg max-w-2xl mx-auto font-medium px-4 sm:px-0"
      data-i18n="Phrase-1"
      style="font-family: 'Inter', sans-serif;"
    >
      La plataforma inteligente de inventario
    </p>
  </div>

  <!-- Scroll Indicator -->
  <div
    class="absolute bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 scroll-indicator flex flex-col items-center justify-center flex-1"
  >
    <span
      data-i18n="Move-Mouse"
      class="text-center text-[10px] uppercase tracking-widest text-gray-800 dark:text-gray-300 mb-2 opacity-70 font-medium"
    >
      Explorar
    </span>
    <!-- Mobile: Chevron arrow -->
    <svg
      class="w-8 h-8 text-gray-800 dark:text-gray-300 sm:hidden"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
    <!-- Desktop: Mouse -->
    <div
      class="hidden sm:flex w-6 h-10 border-2 border-gray-800 dark:border-gray-300 rounded-full items-start justify-center p-1"
    >
      <div class="w-1.5 h-2.5 bg-gray-800 dark:bg-gray-300 rounded-full"></div>
    </div>
  </div>
</section>

<script>
  import { translate, getCurrentLang } from "./additionals/scripts/i18n";

  let currentLang = getCurrentLang();

  const changingTitle = document.getElementById(
    "changing-title",
  ) as HTMLElement;
  const titles = ["Title-1.1", "Title-1.3", "Title-1.5"] as const;

  type TitleKey = (typeof titles)[number];

  let currentTitleIndex = 0;
  let isErasing = false;
  let isTyping = false;

  function sleep(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  async function typeWriter(
    text: string | null,
    element: HTMLElement,
  ): Promise<void> {
    if (text === null || isTyping) return;

    isTyping = true;
    let currentLength = 0;

    while (currentLength <= text.length) {
      const newLang = getCurrentLang();
      if (currentLang !== newLang) {
        currentLang = newLang;
        text = translate(titles[currentTitleIndex] as TitleKey, currentLang);
      }
      element.textContent = text.substring(0, currentLength);
      currentLength++;
      await sleep(100);
    }

    isTyping = false;
  }

  async function eraseText(element: HTMLElement): Promise<void> {
    if (isErasing) return;

    isErasing = true;
    let text = element.textContent;

    if (text === null) {
      isErasing = false;
      return;
    }

    let currentLength = text.length;
    while (currentLength > 0) {
      const newLang = getCurrentLang();
      if (currentLang !== newLang) {
        currentLang = newLang;
        text = translate(titles[currentTitleIndex] as TitleKey, currentLang);
        currentLength = Math.min(currentLength, text.length);
      }
      element.textContent = text.substring(0, currentLength);
      currentLength--;
      await sleep(50);
    }

    isErasing = false;
  }

  async function changeTitle() {
    // Initial delay
    await sleep(5000);

    // Add cursor
    changingTitle.classList.add("cursor-active");

    // First erase the initial title
    await eraseText(changingTitle);

    while (true) {
      currentLang = getCurrentLang();

      // Type new title
      const translatedTitle = translate(
        titles[currentTitleIndex] as TitleKey,
        currentLang,
      );
      await typeWriter(translatedTitle, changingTitle);

      // Wait
      await sleep(15000);

      // Erase
      await eraseText(changingTitle);

      // Move to next title
      currentTitleIndex = (currentTitleIndex + 1) % titles.length;
    }
  }

  // Language change observer
  const languageObserver = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === "attributes" && mutation.attributeName === "lang") {
        const newLang = getCurrentLang();
        if (newLang !== currentLang) {
          currentLang = newLang;
          if (!isErasing && !isTyping) {
            const translatedTitle = translate(
              titles[currentTitleIndex] as TitleKey,
              currentLang,
            );
            changingTitle.textContent = translatedTitle;
          }
        }
      }
    });
  });

  languageObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["lang"],
  });

  // Start animation
  changeTitle();

  window.addEventListener("pagehide", () => {
    languageObserver.disconnect();
  });
</script>
