---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import CustomToaster from "../components/ui/CustomToast.tsx";
import "@/styles/globals.css";
import "@fontsource-variable/roboto-flex";

interface Props {
	title: string;
}

const { title } = Astro.props;

const lang = Astro.cookies.get("NEXT_LOCALE")?.value || "es";
---

<!doctype html>
<html lang={lang} class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Sistema de gestión de inventario de objetos en Venezuela"
		/>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/flag.svg" />
		<title>{title}</title>
		<script>
			import { initializeLanguage } from "../components/additionals/scripts/i18n-init";

			// Run on Astro page navigation
			document.addEventListener("astro:page-load", initializeLanguage);

			// Also run on DOMContentLoaded for initial page load
			document.addEventListener("DOMContentLoaded", initializeLanguage);

			// Run immediately if DOM is already ready (for cached pages)
			if (
				document.readyState === "complete" ||
				document.readyState === "interactive"
			) {
				initializeLanguage();
			}
		</script>
		<script
			is:inline
			src="https://challenges.cloudflare.com/turnstile/v0/api.js"
			async
			defer></script>
		<script is:inline>
			if (
				localStorage.getItem("color-theme") === "dark" ||
				(!("color-theme" in localStorage) &&
					window.matchMedia("(prefers-color-scheme: dark)").matches)
			) {
				document.documentElement.classList.add("dark");
			} else {
				document.documentElement.classList.remove("dark");
			}
		</script>
		<script is:inline>
			(function () {
				var translations = {
					es: {
						"Title-2": "ARCHIVAR",
						"Phrase-1": "La plataforma inteligente de inventario",
						"Phrase-2": "Registro histórico de objetos dados de baja",
						"Navbar-1": "Inventario Activo",
						"Navbar-2": "Registrar Objeto",
						"Navbar-3": "Archivados",
						"Navbar-4": "Analíticas",
						"Title-1": "DATATRACKER",
						"Title-1.3": "#INVENTARIO",
						"Title-3": "Registrar Nuevo Objeto",
						"Component-1": "Buscar Registros",
						"Component-2": "Listado de Objetos Registrados",
					},
					en: {
						"Title-2": "ARCHIVED",
						"Phrase-1": "The intelligent inventory platform",
						"Phrase-2": "Historical record of decommissioned items",
						"Navbar-1": "Active Inventory",
						"Navbar-2": "Register Object",
						"Navbar-3": "Archived",
						"Navbar-4": "Analytics",
						"Title-1": "DATATRACKER",
						"Title-1.3": "#INVENTORY",
						"Title-3": "Register New Object",
						"Component-1": "Search Records",
						"Component-2": "List of Registered Objects",
					},
				};
				function getCookie(n) {
					var m = document.cookie.match(
						new RegExp("(^| )" + n + "=([^;]+)"),
					);
					return m ? m[2] : null;
				}
				var lang =
					localStorage.getItem("language") ||
					getCookie("NEXT_LOCALE") ||
					document.documentElement.lang ||
					"es";
				if (lang !== "es" && lang !== "en") lang = "es";
				document.documentElement.lang = lang;
				function apply() {
					var t = translations[lang];
					if (!t) return;
					document
						.querySelectorAll("[data-i18n]")
						.forEach(function (el) {
							var k = el.getAttribute("data-i18n");
							if (k && t[k]) el.textContent = t[k];
						});
					// Handle HTML translations (controlled content only)
					document
						.querySelectorAll("[data-i18n-html]")
						.forEach(function (el) {
							var k = el.getAttribute("data-i18n-html");
							if (k && t[k]) el.innerHTML = t[k];
						});
				}
				if (document.readyState === "loading") {
					document.addEventListener("DOMContentLoaded", apply);
				} else {
					apply();
				}
				document.addEventListener("astro:page-load", apply);
			})();
		</script>
	</head>
	<body
		class="flex flex-col min-h-full bg-background text-foreground theme-transition"
	>
		<Navbar />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
		<CustomToaster client:load />
	</body>
</html>
<style is:global>
	html {
		font-family: "Roboto Flex Variable", sans-serif;
	}
</style>
