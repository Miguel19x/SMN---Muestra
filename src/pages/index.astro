---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header.astro";
import InfoSection from "../components/InfoSection.astro";
import MotorDeBusqueda from "../components/MotorDeBusqueda.tsx";
import FeatureShowcase from "../components/FeatureShowcase.tsx";
import "@/styles/globals.css";
---

<Layout title="DataTracker">
	<div class="min-h-screen flex flex-col theme-transition">
		<main class="flex-grow">
			<Header />
			<!-- Motor de búsqueda: crítico, carga inmediata -->
			<MotorDeBusqueda client:load />
			<!-- Feature Showcase: no crítico, carga cuando el navegador esté inactivo -->
			<FeatureShowcase client:idle />
			<InfoSection />
		</main>
	</div>
</Layout>
