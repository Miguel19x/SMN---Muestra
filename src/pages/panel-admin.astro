---
import Layout from "../layouts/Layout.astro";
import PanelEngine from "../components/PanelEngine.tsx";
import "@/styles/globals.css";
import { parse } from "cookie";
import jwt from "jsonwebtoken";
import { connectDB } from "../lib/mongodb.ts";

// Conectar a la base de datos de forma segura
try {
  await connectDB();
} catch (error) {
  console.warn("Modo Demo: MongoDB no disponible, operando en memoria");
}

// Obtener las cookies de la solicitud
const cookies = parse(Astro.request.headers.get("cookie") || "");
const token = cookies.token;

let isAuthenticated = false;

if (token) {
  if (token === "demo-admin-token") {
    isAuthenticated = true;
  } else {
    try {
      // Verificar el token JWT
      const secretKey = import.meta.env.SECRET_JWT_KEY || process.env.SECRET_JWT_KEY || 'datatracker-demo-jwt-secret-key-2026';
      const decoded = jwt.verify(token, secretKey);
      if (typeof decoded === "object" && decoded.userId) {
        isAuthenticated = true;
      }
    } catch (error) {
      console.error("Token inválido:", error);
    }
  }
}

if (!isAuthenticated) {
  return Astro.redirect("/login");
}
---

<Layout title="DataTracker - Admin">
  <div style="height: 60px;"></div>
  <PanelEngine client:load />
  <div style="height: 60px;"></div>
</Layout>
